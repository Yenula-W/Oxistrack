# --- Database (MySQL) ---
DATABASE_URL=mysql+pymysql://oxistrack:oxistrack@127.0.0.1:3306/oxistrack?charset=utf8mb4

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Uploads ---
UPLOAD_DIR=./storage
MAX_UPLOAD_MB=15

# --- AI provider ---
# auto: use the LLM when LLM_API_KEY is set, otherwise the built-in rule-based engine.
# heuristic: always use the rule-based engine. openai_compatible: always use the LLM.
AI_PROVIDER=auto
# Any OpenAI-compatible chat-completions endpoint works (set the base URL of your provider).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Second AI (optional reviewer) ---
# An independent model, ideally from a different vendor than LLM_MODEL. It double-checks source choices,
# breaks ties and settles unclear requirement checks. Leave REVIEWER_MODEL empty to turn it off.
# With OpenRouter (https://openrouter.ai/api/v1) one key reaches both models, for example:
#   LLM_MODEL=anthropic/claude-haiku-5.5   REVIEWER_MODEL=openai/gpt-4.1-mini
REVIEWER_BASE_URL=
REVIEWER_API_KEY=
REVIEWER_MODEL=
